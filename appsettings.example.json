{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "TokenLifetimeHours": 24
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db",
    "Hangfire": "hangfire.db"
  },
  "Email": {
    "From": "weather@localhost",
    "ReportRecipient": "admin@example.com",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseSsl": false,
      "Username": "",
      "Password": ""
    }
  }
}
